# Build context for Dockerfile.prod. The dev .dockerignore excludes everything but
# docker/, so this file (which BuildKit prefers for Dockerfile.prod) overrides it.

# Secrets and local state must never be baked into an image.
.env
.env.*
!.env.example
*.sqlite

# Rebuilt inside the image.
vendor/
node_modules/

# Runtime data.
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# Not needed to run.
tests/
.phpunit.result.cache
Dockerfile*
