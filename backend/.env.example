APP_NAME="HRIS Arcenas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

# The API runs on 8090 (the mobile app and the web proxy target it). Under
# Docker the port comes from compose.yaml; this only matters when running
# `php artisan serve` on the host, where 8000 is taken on the dev machine.
SERVER_PORT=8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The Docker MySQL (compose.yaml), as seen from the HOST — for artisan run
# outside the containers. The containers ignore these: compose.yaml sets
# DB_HOST=mysql and DB_PORT=3306 as real environment variables, which win.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=hris
DB_USERNAME=hris
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Redis Cluster for the cache. Empty here: `php artisan serve` on the host has
# no cluster, and CACHE_STORE=database above keeps it working. compose.yaml
# sets CACHE_STORE=redis, REDIS_CACHE_CONNECTION=cluster and this seed list for
# the containers. Whatever the cache does, a cached read falls back to MySQL
# when Redis cannot answer.
REDIS_CACHE_CONNECTION=cache
REDIS_CLUSTER_NODES=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
