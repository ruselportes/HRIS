# Copy to .env.prod on the server and fill it in. .env.prod is gitignored: never
# commit it. Used by compose.prod.yaml via `--env-file .env.prod`.
#
# Every HRIS_* / SESSION_DRIVER key below is mapped through compose.prod.yaml's
# x-api-env into the containers, so these values actually reach the app. An
# omitted (or blank) key falls back to the default shown here.

# Strong, unique values (e.g. `openssl rand -base64 24`). No spaces or quotes.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Generate once with:  echo "base64:$(openssl rand -base64 32)"
# Keep a copy somewhere safe. device_keys.hmac_key is encrypted with this key,
# so changing it orphans every bound device (CLAUDE.md §4).
APP_KEY=

# Where the portal is reached, e.g. http://192.168.1.11 or the Tailscale address.
APP_URL=

# Leave false until the team enforces hardware-backed keys in production
# (docs/CRYPTOGRAPHY_EXPLAINED.md).
HRIS_REQUIRE_HARDWARE_KEYS=false

# Nothing uses sessions yet, but the default driver (database) has no table, so
# the first session-based feature would 500. file needs no schema.
SESSION_DRIVER=file

# Runs `php artisan migrate --force` on every API start (idempotent). Set false
# if you prefer to migrate manually before the demo so a failed migration
# cannot take the API down mid-demo.
HRIS_MIGRATE_ON_START=true

# Date the "no time-out recorded" payslip warning starts from.
HRIS_TIME_OUT_TRACKED_FROM=2026-09-21

# DOLE regional minimum wage, Region VII (Central Visayas), non-agriculture, in
# PHP. The payroll tax exclusions depend on this figure. [VERIFY] against the
# wage order in force before the demo (docs/PH_LABOR_AND_PAYROLL_EXPLAINED.md).
HRIS_REGIONAL_MINIMUM_WAGE=501.00

# Scheduled work days, 1=Mon .. 7=Sun. 1,2,3,4,5,6 = Monday to Saturday.
HRIS_WORK_DAYS=1,2,3,4,5,6

# ISO day number of the weekly rest day (7 = Sunday).
HRIS_REST_DAY_ISO=7

# Regular shift window (24h, Asia/Manila local time).
HRIS_SHIFT_START=07:00
HRIS_SHIFT_END=16:00
HRIS_MEAL_START=12:00
HRIS_MEAL_END=13:00

# How far back a foreman can request a crew recovery sign-off, in days.
HRIS_RECOVERY_LOOKBACK_DAYS=14

# Clock-skew tolerance for hardware-signed attendance, in seconds.
HRIS_CLOCK_SKEW_TOLERANCE=120

# Grace minutes before a late arrival can be overridden as on-time.
HRIS_LATE_OVERRIDE_GRACE_MINUTES=15

# Local timezone the attendance calendar runs on.
HRIS_ATTENDANCE_TIMEZONE=Asia/Manila
